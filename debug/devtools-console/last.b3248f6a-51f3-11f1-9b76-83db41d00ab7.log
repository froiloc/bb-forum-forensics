/**
 * IIFE-Diagnosescript: Bug 2.97 / 2.107
 * Berichtseditor — Doppelklick-Einfügen erzeugt Doppelblock + 3 Formular-Einträge
 *
 * ANLEITUNG:
 *   1. Berichtseditor öffnen (/_forensic/report), neuen Bericht anlegen.
 *   2. DevTools → Console öffnen.
 *   3. Dieses gesamte Script in die Console einfügen und Enter drücken.
 *   4. Bestätigung "DIAG 2.97/2.107: Monitoring aktiv." abwarten.
 *   5. In Bausteine > Module auf ein Modul DOPPELKLICKEN.
 *   6. Ca. 3 Sekunden warten bis Auto-Save-Debounce abgelaufen ist.
 *   7. Alle Ausgaben mit Präfix [DIAG] aus der Console kopieren und bereitstellen.
 *
 * WAS BEOBACHTET WIRD:
 *   A) Ob und wann _isProgrammaticInsert gesetzt/freigegeben wird
 *   B) Wie viele onChange-Events editor.js feuert und von welchem Typ
 *   C) Welche Block-IDs zu jedem Zeitpunkt im Editor vorhanden sind
 *   D) Was _performAutoSave an den Server sendet (fetch-Intercept)
 *   E) Ob der Guard zum Zeitpunkt des Auto-Save-Feuerns noch aktiv ist
 */
(function () {
    'use strict';

    const TAG = '[DIAG 2.97/2.107]';
    const ts  = () => new Date().toISOString().slice(11, 23); // HH:MM:SS.mmm

    // -----------------------------------------------------------------------
    // A) _isProgrammaticInsert überwachen via Object.defineProperty
    //    auf window.ReportEditor (der Guard-Setter schreibt _isProgrammaticInsert
    //    als Closure-Variable — wir beobachten die öffentliche API stattdessen)
    // -----------------------------------------------------------------------
    const origBegin = window.ReportEditor?.beginProgrammaticInsert;
    const origEnd   = window.ReportEditor?.endProgrammaticInsert;

    if (!origBegin || !origEnd) {
        console.warn(TAG, 'WARNUNG: window.ReportEditor.beginProgrammaticInsert/endProgrammaticInsert nicht gefunden!');
        console.warn(TAG, 'Entweder ist Build 202 nicht geladen oder report_editor.js ist veraltet.');
        console.warn(TAG, 'window.ReportEditor =', window.ReportEditor);
        console.warn(TAG, '_buildnr =', window._buildnr);
    } else {
        window.ReportEditor.beginProgrammaticInsert = function () {
            console.debug(TAG, ts(), 'beginProgrammaticInsert() aufgerufen — Guard AKTIV');
            console.trace(TAG, 'beginProgrammaticInsert callstack:');
            return origBegin.apply(this, arguments);
        };
        window.ReportEditor.endProgrammaticInsert = function () {
            console.debug(TAG, ts(), 'endProgrammaticInsert() aufgerufen — Guard FREIGEGEBEN');
            console.trace(TAG, 'endProgrammaticInsert callstack:');
            return origEnd.apply(this, arguments);
        };
        console.debug(TAG, 'Guard-API-Wrapper installiert.');
    }

    // -----------------------------------------------------------------------
    // B) Editor.js onChange-Events abfangen
    //    Editor.js ruft intern _editor._callbacks.onChange auf — wir wrappen
    //    das erst NACH der Initialisierung (Editor muss bereits bereit sein).
    //    Polling bis window._editor verfügbar ist.
    // -----------------------------------------------------------------------
    let _editorWrapInstalled = false;
    function _installEditorWrap() {
        if (_editorWrapInstalled) return;
        const ed = window._editor;
        if (!ed) return;

        // Editor.js speichert onChange in ed.configuration.onChange
        // Wir wrappen den _scheduleAutoSave-Trigger indem wir auf dem
        // Editor-Objekt selbst horchen — via Proxy auf blocks.insert
        const origInsert = ed.blocks?.insert?.bind(ed.blocks);
        if (origInsert && ed.blocks) {
            ed.blocks.insert = function (...args) {
                console.debug(TAG, ts(), 'editor.blocks.insert() aufgerufen',
                    '| args[0] (type):', args[0],
                    '| _isProgrammaticInsert zur Zeit:', window._diag_isProgrammaticInsert ?? '(nicht messbar)');
                const result = origInsert(...args);
                // Block-IDs NACH insert
                setTimeout(() => {
                    const ids = [];
                    try {
                        const n = ed.blocks.getBlocksCount();
                        for (let i = 0; i < n; i++) {
                            ids.push(ed.blocks.getBlockByIndex(i)?.id ?? '?');
                        }
                    } catch (e) { ids.push('(Fehler: ' + e.message + ')'); }
                    console.debug(TAG, ts(), 'Block-IDs im Editor NACH insert:', ids);
                }, 0);
                return result;
            };
            console.debug(TAG, 'editor.blocks.insert Wrapper installiert.');
        }

        _editorWrapInstalled = true;
    }

    // Polling alle 200ms bis Editor bereit
    const _pollTimer = setInterval(() => {
        if (window._editor?.blocks) {
            _installEditorWrap();
            clearInterval(_pollTimer);
        }
    }, 200);

    // -----------------------------------------------------------------------
    // C) fetch-Intercept: alle POST /_forensic/editor-Requests loggen
    //    (save_block, save, delete) um zu sehen was tatsächlich an den
    //    Server gesendet wird und in welcher Reihenfolge
    // -----------------------------------------------------------------------
    const origFetch = window.fetch;
    window.fetch = async function (url, opts) {
        const urlStr = typeof url === 'string' ? url : url?.url ?? String(url);

        // Nur Editor-API-Calls interessieren uns
        if (urlStr.includes('/_forensic/editor') || urlStr.includes('/_forensic/report')) {
            const method = opts?.method || 'GET';
            let body = null;
            try { body = opts?.body ? JSON.parse(opts.body) : null; } catch (_) {}

            if (method === 'POST' && body) {
                console.debug(TAG, ts(),
                    `fetch POST ${urlStr}`,
                    '| action:', body.action ?? '(kein action)',
                    '| block_id:', body.block_id ?? '—',
                    '| report_id:', body.report_id ?? '—',
                    '| block_type:', body.block_type ?? '—',
                    '| block_data (gekürzt):', body.block_data
                        ? JSON.stringify(body.block_data).slice(0, 80) + '...'
                        : '—'
                );
            }
        }

        // Original-fetch aufrufen
        return origFetch.apply(this, arguments);
    };
    console.debug(TAG, 'fetch-Intercept installiert (POST /_forensic/editor + /report).');

    // -----------------------------------------------------------------------
    // D) _insertModule-Aufrufe in module_panel.js tracen
    //    Wir überwachen ModulePanel._insertModule via window.ModulePanel-Export
    // -----------------------------------------------------------------------
    // _insertModule ist nicht direkt exportiert — wir observen stattdessen
    // über den dblclick-Event auf .mp-item-Elementen (bereits via _uevt geloggt)
    // und kombinieren das mit den fetch-Aufrufen.

    // -----------------------------------------------------------------------
    // E) showPlaceholderForm überwachen
    // -----------------------------------------------------------------------
    const origWizard = window.PlaceholderWizard?.showPlaceholderForm;
    if (origWizard && window.PlaceholderWizard) {
        window.PlaceholderWizard.showPlaceholderForm = function (blocks, focusedId, opts) {
            const ids = (blocks || []).map(b => b.block_id ?? '(kein block_id)');
            console.debug(TAG, ts(),
                'showPlaceholderForm aufgerufen | blocks.length:', (blocks || []).length,
                '| focusedId:', focusedId,
                '| block_ids:', ids
            );
            console.trace(TAG, 'showPlaceholderForm callstack:');
            return origWizard.apply(this, arguments);
        };
        console.debug(TAG, 'PlaceholderWizard.showPlaceholderForm Wrapper installiert.');
    } else {
        console.warn(TAG, 'WARNUNG: PlaceholderWizard.showPlaceholderForm nicht gefunden!');
    }

    // -----------------------------------------------------------------------
    // F) _currentBlocks zur Diagnosezeit ausgeben (alle 500ms nach Doppelklick)
    //    Wir beobachten _insertModule-Aufruf via Sentinel auf dblclick
    // -----------------------------------------------------------------------
    document.addEventListener('dblclick', (evt) => {
        if (!evt.target.closest('.mp-item')) return;
        console.debug(TAG, ts(), 'DOPPELKLICK auf .mp-item erkannt — starte Zeitreihen-Dump');

        const snapshots = [0, 100, 200, 500, 1000, 1600, 2000, 2500, 3000];
        snapshots.forEach(delay => {
            setTimeout(() => {
                const edIds = [];
                try {
                    const ed = window._editor;
                    if (ed?.blocks) {
                        const n = ed.blocks.getBlocksCount();
                        for (let i = 0; i < n; i++) {
                            edIds.push(ed.blocks.getBlockByIndex(i)?.id ?? '?');
                        }
                    }
                } catch (e) { edIds.push('Fehler: ' + e.message); }

                const dbIds = (window._currentBlocksDebug ?? []).map(b => b.block_id ?? '?');
                console.debug(TAG, ts(),
                    `T+${delay}ms | Editor-IDs:`, edIds,
                    '| _currentBlocks IDs:', dbIds.length ? dbIds : '(nicht zugänglich)',
                    '| Guard aktiv:', window.ReportEditor?._insertGuardTimer !== undefined
                        ? '(Timer existiert — Guard möglicherweise aktiv)'
                        : '(kein Timer)'
                );
            }, delay);
        });
    }, { capture: true, passive: true });

    console.debug(TAG, '='.repeat(60));
    console.debug(TAG, 'DIAG 2.97/2.107: Monitoring aktiv.');
    console.debug(TAG, 'Jetzt bitte: Bausteine > Module > Doppelklick auf ein Modul.');
    console.debug(TAG, '='.repeat(60));

})();
