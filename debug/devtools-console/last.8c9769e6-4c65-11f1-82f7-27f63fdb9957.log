// Diagnose: Standard-Items im DOM auf Drag-Fähigkeit prüfen
(function() {
  const list = document.getElementById('mp-list');
  if (!list) { console.warn('⛔ #mp-list nicht gefunden'); return; }

  const items = list.querySelectorAll('.mp-item, .mp-item--standard');
  console.log('Gefundene Items:', items.length);

  items.forEach((item, i) => {
    console.log(`Item ${i}:`, {
      classes:        item.className,
      draggable:      item.getAttribute('draggable'),
      blockType:      item.dataset.blockType,
      stdType:        item.dataset.stdType,
      moduleId:       item.dataset.moduleId,
      hasInsertBtn:   !!item.querySelector('button'),
    });
  });

  // Drop-Zone prüfen
  const holder = document.getElementById('editorjs-holder');
  console.log('editorjs-holder gefunden:', !!holder);
  console.log('ModulePanel._setSavedCursorRange:', typeof window._ModulePanel?._setSavedCursorRange);
})();
