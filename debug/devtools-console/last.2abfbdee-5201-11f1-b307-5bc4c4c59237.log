/**
 * IIFE-Diagnosescript: Bug 2.98
 * Block löschen → Formular-Bereich aktualisiert sich nicht sofort
 *
 * ANLEITUNG:
 *   1. Berichtseditor öffnen, neuen Bericht anlegen.
 *   2. Ein Modul per Doppelklick einfügen.
 *   3. Im Formular-Bereich in ein Eingabefeld klicken (Fokus ins Formular setzen).
 *   4. Dieses Script in DevTools-Console einfügen + Enter drücken.
 *   5. "[DIAG 2.98] Monitoring aktiv" abwarten.
 *   6. Den Block in Editor.js per Toolbar-Menü (⋮ → Löschen) löschen.
 *      WICHTIG: Bitte NICHT per Backspace löschen.
 *   7. Ca. 3 Sekunden warten.
 *   8. Alle [DIAG 2.98]-Zeilen kopieren und bereitstellen.
 *
 * WAS BEOBACHTET WIRD:
 *   A) Ob onChange mit 'block-removed' feuert
 *   B) Wert von formFocused zum Zeitpunkt des onChange
 *   C) Ob _refreshPlaceholderForm aufgerufen wird
 *   D) Ob showPlaceholderForm danach aufgerufen wird
 *   E) Ob delete_block-Request gesendet wird
 */
(function () {
    'use strict';

    const TAG = '[DIAG 2.98]';
    const ts  = () => new Date().toISOString().slice(11, 23);

    console.debug(TAG, '='.repeat(50));
    console.debug(TAG, 'Build:', window._buildnr ?? '?');

    // -----------------------------------------------------------------------
    // A) activeElement beim Klick auf Toolbar-Löschen protokollieren
    // -----------------------------------------------------------------------
    document.addEventListener('click', (evt) => {
        const active = document.activeElement;
        const inForm = !!active?.closest('#accordion-body-form');
        const label  = active?.tagName + (active?.id ? '#' + active.id : '') +
                       (active?.className && typeof active.className === 'string'
                           ? '.' + active.className.trim().split(/\s+/)[0] : '');
        console.debug(TAG, ts(), 'CLICK-EVENT',
            '| target:', evt.target?.className?.toString?.()?.slice(0, 40),
            '| activeElement:', label,
            '| inFormular:', inForm
        );
    }, { capture: true, passive: true });

    // -----------------------------------------------------------------------
    // B) MutationObserver — ce-block Entfernung aus #editorjs-holder
    // -----------------------------------------------------------------------
    function _installMO() {
        const holder = document.getElementById('editorjs-holder');
        if (!holder || holder._diag98MO) return;
        holder._diag98MO = true;

        const mo = new MutationObserver((mutations) => {
            for (const m of mutations) {
                for (const node of m.removedNodes) {
                    if (node.nodeType === 1 && node.classList?.contains('ce-block')) {
                        const blockId = node.dataset?.id ?? '?';
                        const active  = document.activeElement;
                        const inForm  = !!active?.closest('#accordion-body-form');
                        console.debug(TAG, ts(),
                            'MO: ce-block ENTFERNT aus DOM',
                            '| block_id:', blockId.slice(0, 8),
                            '| activeElement inFormular:', inForm,
                            '| activeElement tag:', active?.tagName
                        );
                    }
                }
            }
        });
        mo.observe(holder, { childList: true, subtree: false });
        console.debug(TAG, 'MutationObserver auf #editorjs-holder installiert.');
    }

    // Sofort und nach Reload installieren
    _installMO();
    setInterval(() => {
        const holder = document.getElementById('editorjs-holder');
        if (holder && !holder._diag98MO) _installMO();
    }, 300);

    // -----------------------------------------------------------------------
    // C) _refreshPlaceholderForm überwachen
    // -----------------------------------------------------------------------
    const origWizard = window.PlaceholderWizard?.showPlaceholderForm;
    if (origWizard && window.PlaceholderWizard) {
        window.PlaceholderWizard.showPlaceholderForm = function (blocks, focusedId, opts) {
            console.debug(TAG, ts(),
                'showPlaceholderForm aufgerufen',
                '| blocks.length:', (blocks || []).length,
                '| focusedId:', focusedId?.slice(0, 8) ?? 'null'
            );
            console.trace(TAG, 'showPlaceholderForm callstack:');
            return origWizard.apply(this, arguments);
        };
        console.debug(TAG, 'PlaceholderWizard.showPlaceholderForm Wrapper installiert.');
    }

    // -----------------------------------------------------------------------
    // D) fetch-Intercept — delete_block-Requests protokollieren
    // -----------------------------------------------------------------------
    const origFetch = window.fetch;
    window.fetch = async function (url, opts) {
        const urlStr = typeof url === 'string' ? url : url?.url ?? String(url);
        if (urlStr.includes('/_forensic/editor') || urlStr.includes('/_forensic/report')) {
            const method = opts?.method || 'GET';
            let body = null;
            try { body = opts?.body ? JSON.parse(opts.body) : null; } catch (_) {}
            if (method === 'POST' && body) {
                const active = document.activeElement;
                const inForm = !!active?.closest('#accordion-body-form');
                console.debug(TAG, ts(),
                    'fetch POST', urlStr.split('/').pop(),
                    '| action:', body.action ?? '—',
                    '| block_id:', (body.block_id ?? '—').slice(0, 8),
                    '| activeElement inFormular:', inForm
                );
            }
        }
        return origFetch.apply(this, arguments);
    };

    // -----------------------------------------------------------------------
    // E) Periodischer Formular-Status-Dump (alle 500ms für 35 Sekunden)
    // -----------------------------------------------------------------------
    let _deleteDetected = false;
    let _dumpCount = 0;

    // Auf MO-Block-Entfernung warten, dann Dumps starten
    const _origInstallMO = _installMO;
    function _installMOWithDump() {
        const holder = document.getElementById('editorjs-holder');
        if (!holder || holder._diag98MO2) return;
        holder._diag98MO2 = true;

        const mo2 = new MutationObserver((mutations) => {
            for (const m of mutations) {
                for (const node of m.removedNodes) {
                    if (node.nodeType === 1 && node.classList?.contains('ce-block')) {
                        if (_deleteDetected) return;
                        _deleteDetected = true;
                        console.debug(TAG, ts(), '>>> Block-Löschung erkannt — starte Formular-Monitoring (35s) <<<');

                        const interval = setInterval(() => {
                            _dumpCount++;
                            const formBody = document.getElementById('accordion-body-form');
                            const groups   = formBody?.querySelectorAll('.pf-block-group') ?? [];
                            const groupIds = Array.from(groups).map(g =>
                                g.dataset.blockId?.slice(0, 8) ?? '?'
                            );
                            const active  = document.activeElement;
                            const inForm  = !!active?.closest('#accordion-body-form');
                            console.debug(TAG, ts(),
                                `T+${_dumpCount * 500}ms nach Delete`,
                                '| Formular-Gruppen:', groups.length,
                                '| block_ids:', groupIds.join(', '),
                                '| activeElement inFormular:', inForm
                            );
                            if (_dumpCount >= 70) {  // 35 Sekunden
                                clearInterval(interval);
                                console.debug(TAG, ts(), 'Formular-Monitoring beendet.');
                            }
                        }, 500);
                    }
                }
            }
        });
        mo2.observe(holder, { childList: true, subtree: false });
    }

    _installMOWithDump();
    setInterval(() => {
        const holder = document.getElementById('editorjs-holder');
        if (holder && !holder._diag98MO2) _installMOWithDump();
    }, 300);

    console.debug(TAG, 'Monitoring aktiv. Bitte jetzt Block per Toolbar-Menü löschen.');
    console.debug(TAG, '='.repeat(50));

})();
