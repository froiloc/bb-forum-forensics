(async function () {
  'use strict';
  // =====================================================================
  // AIW · Build-312 · Console-PoC: SSE role=main Selbst-Kollision
  // ---------------------------------------------------------------------
  // ZIEL: Belegen, dass ein GET OHNE Header 'X-Forensic-Preflight: 1' vom
  //       Server als echter Stream behandelt wird und die Rolle BEANSPRUCHT
  //       — wodurch die nachfolgende EventSource 409 bekommt. Genau das tut
  //       der aktuelle SupportIndicatorModule.
  // SICHERHEIT: Test laeuft gegen eine zufaellige SANDBOX-Rolle (nie 'main'),
  //       der header-lose Stream wird abgebrochen und der Slot heilt nach der
  //       Grace-Period (5s) selbst. Kein Eingriff in echte Sitzungen/Locks.
  // =====================================================================
  var TAG  = '[AIW-PoC-409]';
  var BASE = (window.ForensicToolbar && ForensicToolbar.config && ForensicToolbar.config.API_EVENTS) || '/_forensic/events';
  var SANDBOX = 'poc_probe_' + Math.random().toString(36).slice(2, 8);
  var results = [];
  var sleep = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };

  function verdict(name, ok, detail) {
    results.push({ test: name, ergebnis: ok ? 'PASS' : 'FAIL', detail: detail });
    console.log(TAG, ok ? '✅ PASS' : '❌ FAIL', name, '—', detail);
  }
  // Preflight MIT Header: reiner Slot-Check, beansprucht NICHT.
  async function preflight(role) {
    var url = location.origin + BASE + '?role=' + encodeURIComponent(role);
    var r = await fetch(url, { method: 'GET', headers: { 'X-Forensic-Preflight': '1', 'Accept': 'application/json' }, cache: 'no-store' });
    var body = null; try { body = await r.json(); } catch (e) {}
    return { status: r.status, body: body };
  }
  // Header-LOSER GET (wie der aktuelle SupportIndicatorModule): wird als echter
  // Stream behandelt. Body wird NICHT gelesen -> Verbindung bleibt offen.
  function openHeaderless(role, ctrl) {
    var url = location.origin + BASE + '?role=' + encodeURIComponent(role);
    return fetch(url, { method: 'GET', headers: { 'Accept': 'text/event-stream, application/json' }, cache: 'no-store', signal: ctrl.signal });
  }

  console.group(TAG + ' Start — Sandbox-Rolle: ' + SANDBOX);
  try {
    // P0: aktuellen ECHTEN main-Slot befragen (belegt die aktuelle Selbstblockade)
    var p0 = await preflight('main');
    console.log(TAG, 'P0 realer main-Slot:', p0.status, p0.body);
    verdict('P0 main-Slot aktuell belegt (Selbstblockade)', p0.status === 409,
            'status=' + p0.status + ' active_window_id=' + (p0.body && p0.body.active_window_id));

    // P1: Sandbox-Rolle vor dem Test frei?
    var p1 = await preflight(SANDBOX);
    verdict('P1 Sandbox frei vor Test (=> 200)', p1.status === 200, 'status=' + p1.status);

    // P2/P3: header-LOSER Request beansprucht die Rolle
    var ctrl = new AbortController();
    openHeaderless(SANDBOX, ctrl).catch(function () {}); // Abort-Fehler ignorieren
    await sleep(900);                                     // claim_sse_role() abwarten
    var p3 = await preflight(SANDBOX);
    verdict('P3 header-LOSER GET beansprucht Rolle (=> 409)', p3.status === 409,
            'status=' + p3.status + ' active_window_id=' + (p3.body && p3.body.active_window_id));

    // P4: nach Abort + Grace wieder frei
    ctrl.abort();
    console.log(TAG, 'header-losen Stream abgebrochen — warte Grace (~6.5s)…');
    await sleep(6500);
    var p4 = await preflight(SANDBOX);
    verdict('P4 nach Grace wieder frei (=> 200)', p4.status === 200, 'status=' + p4.status);
  } catch (e) {
    console.error(TAG, 'Fehler im PoC:', e);
  }
  console.groupEnd();

  console.group(TAG + ' ERGEBNIS');
  console.table(results);
  console.groupEnd();
  console.log(TAG, 'Deutung: P3=PASS beweist, dass ein GET OHNE X-Forensic-Preflight die Rolle beansprucht — ' +
                   'genau der Pfad des aktuellen SupportIndicatorModule. Dessen echte EventSource kollidiert danach mit dem eigenen fetch-Stream -> 409 -> kein support_status -> kein Indikator.');
})();
