// Simuliert einen Drop auf den Editor — umgeht das Browser-DnD-System
(function() {
  const holder = document.getElementById('editorjs-holder');
  if (!holder) { console.warn('⛔ #editorjs-holder nicht gefunden'); return; }

  // Synthetisches Drop-Event mit Standard-Block-Daten
  const data = JSON.stringify({ block_type: 'delimiter', title: 'Trennlinie' });
  const dt = new DataTransfer();
  dt.setData('application/x-forensic-standard', data);

  const dropEvt = new DragEvent('drop', {
    bubbles: true, cancelable: true, dataTransfer: dt,
  });
  holder.dispatchEvent(dropEvt);
  console.log('✅ Synthetisches Drop gefeuert. Neuer Block sollte im Editor erscheinen.');
  console.log('Editor Block-Anzahl:', window._editor?.blocks?.getBlocksCount());
})();
