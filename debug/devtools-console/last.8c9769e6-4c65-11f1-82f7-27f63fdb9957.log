// Lauscht auf alle Drag-Events im mp-list
(function() {
  const list = document.getElementById('mp-list');
  if (!list) { console.warn('⛔ #mp-list nicht gefunden'); return; }

  ['dragstart', 'drag', 'dragend'].forEach(evt => {
    list.addEventListener(evt, (e) => {
      console.log(`🎯 ${evt}:`, {
        target:    e.target.className,
        types:     Array.from(e.dataTransfer?.types || []),
        effectAllowed: e.dataTransfer?.effectAllowed,
      });
    }, { once: false });
  });

  const holder = document.getElementById('editorjs-holder');
  if (holder) {
    ['dragover', 'drop', 'dragleave'].forEach(evt => {
      holder.addEventListener(evt, (e) => {
        console.log(`📦 Editor ${evt}:`, {
          types: Array.from(e.dataTransfer?.types || []),
        });
      }, { once: false });
    });
  }

  console.log('✅ Drag-Listener aktiv. Jetzt ein Standard-Element ziehen.');
})();
