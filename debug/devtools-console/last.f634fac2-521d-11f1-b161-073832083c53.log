/**
 * IIFE-Diagnosescript: Bug 2.120
 * Neuer Bericht → Wechsel zu bestehendem → Totalverlust
 *
 * ANLEITUNG:
 *   1. Berichtseditor öffnen. Mindestens einen Bericht mit einem Modul
 *      anlegen und speichern (manuell, einmalig).
 *   2. Script in DevTools-Console einfügen + Enter.
 *   3. "[DIAG 2.120] Bereit" abwarten.
 *   4. Roten Button "[DIAG] 2.120 Test starten" unten rechts klicken.
 *   5. ~10 Sekunden warten bis "ERGEBNIS" erscheint.
 *   6. Alle [DIAG 2.120]-Zeilen bereitstellen.
 */
(function () {
    'use strict';

    const TAG  = '[DIAG 2.120]';
    const ts   = () => new Date().toISOString().slice(11, 23);
    const wait = (ms) => new Promise(r => setTimeout(r, ms));

    // -----------------------------------------------------------------------
    // fetch-Intercept
    // -----------------------------------------------------------------------
    const origFetch = window.fetch;
    const _fetchLog = [];
    window.fetch = async function (url, opts) {
        const urlStr = typeof url === 'string' ? url : url?.url ?? String(url);
        const method = opts?.method || 'GET';
        let body = null;
        try { body = opts?.body ? JSON.parse(opts.body) : null; } catch (_) {}
        const relevant = urlStr.includes('/_forensic/report')
            || urlStr.includes('/_forensic/editor');
        if (relevant) {
            const entry = {
                ts: ts(),
                url: urlStr.replace('http://127.0.0.2:8080', ''),
                method,
                action:    body?.action    ?? null,
                report_id: body?.report_id ?? null,
                block_id:  body?.block_id  ? body.block_id.slice(0, 8) : null,
            };
            _fetchLog.push(entry);
            console.debug(TAG, entry.ts,
                method, entry.url.split('?')[0].split('&')[0],
                'rid=' + (entry.report_id ?? '—'),
                'action=' + (entry.action ?? '—'),
                entry.block_id ? 'bid=' + entry.block_id : ''
            );
        }
        return origFetch.apply(this, arguments);
    };

    // -----------------------------------------------------------------------
    // Hilfsfunktionen
    // -----------------------------------------------------------------------
    function _getEditorBlockIds() {
        const ed = window._editor;
        if (!ed) return [];
        const ids = [];
        try {
            const n = ed.blocks.getBlocksCount();
            for (let i = 0; i < n; i++) {
                const id = ed.blocks.getBlockByIndex(i)?.id;
                if (id) ids.push(id);
            }
        } catch (_) {}
        return ids;
    }

    function _getCurrentReportId() {
        return document.getElementById('report-select')?.value ?? '?';
    }

    function _snap(label) {
        const edIds  = _getEditorBlockIds();
        const report = _getCurrentReportId();
        console.debug(TAG, ts(), '[' + label + ']',
            '| Bericht:', report,
            '| Editor-Blöcke:', edIds.length,
            edIds.length ? '(' + edIds.map(function(id) { return id.slice(0, 8); }).join(', ') + ')' : ''
        );
        return { label: label, report: report, edIds: edIds };
    }

    // -----------------------------------------------------------------------
    // Haupt-Testablauf
    // -----------------------------------------------------------------------
    async function _runTest() {
        _fetchLog.length = 0;
        console.debug(TAG, '='.repeat(60));
        console.debug(TAG, ts(), 'Test startet. Build:', window._buildnr ?? '?');

        // ---- Ausgangszustand ----
        var reportSelectEl = document.getElementById('report-select');
        if (!reportSelectEl) {
            console.error(TAG, 'ABBRUCH: #report-select nicht gefunden.');
            return;
        }

        // Bericht 1 laden
        var opts = Array.from(reportSelectEl.options);
        var report1Opt = opts.find(function(o) { return o.value === '1'; });
        if (!report1Opt) {
            console.error(TAG, 'ABBRUCH: Kein Bericht ID=1. Erst manuell anlegen.');
            return;
        }

        console.debug(TAG, ts(), 'Phase 1: Lade Bericht 1');
        reportSelectEl.value = '1';
        reportSelectEl.dispatchEvent(new Event('change', { bubbles: true }));
        await wait(2000);
        var snap1 = _snap('Bericht 1 geladen');

        if (snap1.edIds.length === 0) {
            console.error(TAG, 'ABBRUCH: Bericht 1 leer. Erst Modul einfügen + Speichern.');
            return;
        }
        var originalBlockIds = snap1.edIds.slice();
        console.debug(TAG, ts(), 'Ursprüngliche Blöcke:',
            originalBlockIds.map(function(id) { return id.slice(0, 8); }).join(', '));

        // Manuell speichern
        console.debug(TAG, ts(), 'Phase 2: Manuell speichern');
        var btnSave = document.getElementById('btn-save-now');
        if (btnSave) btnSave.click();
        await wait(1500);

        // ---- Neuen Bericht erstellen ----
        console.debug(TAG, ts(), 'Phase 3: btn-new-report klicken');
        var btnNew = document.getElementById('btn-new-report');
        if (!btnNew) { console.error(TAG, 'ABBRUCH: btn-new-report fehlt'); return; }
        btnNew.click();
        await wait(600);

        // Modal prüfen
        var dialog = document.getElementById('new-report-dialog');
        if (!dialog) {
            console.error(TAG, 'ABBRUCH: #new-report-dialog nicht erschienen.');
            return;
        }
        console.debug(TAG, ts(), 'Modal vorhanden:', dialog.id);

        var titleInput = document.getElementById('new-report-title');
        if (!titleInput) {
            console.error(TAG, 'ABBRUCH: #new-report-title nicht gefunden.');
            return;
        }

        // Titel eintragen — nativ, ohne framework-spezifische Tricks nötig
        var testTitle = 'DIAG-2120-' + Date.now().toString(36);
        titleInput.focus();
        // Wert direkt setzen und alle relevanten Events feuern
        var nativeInputValueSetter = Object.getOwnPropertyDescriptor(
            window.HTMLInputElement.prototype, 'value'
        ).set;
        nativeInputValueSetter.call(titleInput, testTitle);
        titleInput.dispatchEvent(new Event('input',  { bubbles: true }));
        titleInput.dispatchEvent(new Event('change', { bubbles: true }));
        console.debug(TAG, ts(), 'Titel eingetragen:', testTitle,
            '| input.value jetzt:', titleInput.value);

        await wait(300);

        // Anlegen klicken
        var btnCreate = document.getElementById('btn-create-report');
        if (!btnCreate) {
            console.error(TAG, 'ABBRUCH: #btn-create-report nicht gefunden.');
            return;
        }
        console.debug(TAG, ts(), 'Phase 4: btn-create-report klicken');
        btnCreate.click();
        await wait(2500);
        var snap2 = _snap('Neuer Bericht erstellt');

        // Prüfen ob neuer Bericht wirklich angelegt wurde
        var newReportId = _getCurrentReportId();
        if (newReportId === '1') {
            console.warn(TAG, 'WARNUNG: Bericht-ID immer noch 1 — neuer Bericht evtl. nicht erstellt.',
                'Titel war:', titleInput.value);
        } else {
            console.debug(TAG, ts(), 'Neuer Bericht ID:', newReportId);
        }

        // ---- Zurück zu Bericht 1 ----
        console.debug(TAG, ts(), 'Phase 5: Zurück zu Bericht 1');
        reportSelectEl.value = '1';
        reportSelectEl.dispatchEvent(new Event('change', { bubbles: true }));
        await wait(2500);
        var snap3 = _snap('Nach Rückwechsel zu Bericht 1');

        // ---- Aktualisieren ----
        console.debug(TAG, ts(), 'Phase 6: Aktualisieren');
        var btnRefresh = document.getElementById('btn-refresh-placeholders');
        if (btnRefresh) btnRefresh.click();
        await wait(2000);
        var snap4 = _snap('Nach Aktualisieren');

        // ---- Ergebnis ----
        console.debug(TAG, '='.repeat(60));
        console.debug(TAG, ts(), 'ERGEBNIS:');
        console.debug(TAG, '  Ursprüngliche Blöcke:',
            originalBlockIds.map(function(id) { return id.slice(0, 8); }).join(', '));
        console.debug(TAG, '  Blöcke nach Test:',
            snap4.edIds.map(function(id) { return id.slice(0, 8); }).join(', ') || '(leer!)');

        var verloren = originalBlockIds.filter(function(id) {
            return !snap4.edIds.includes(id);
        });
        var erhalten = originalBlockIds.filter(function(id) {
            return snap4.edIds.includes(id);
        });

        if (verloren.length === 0) {
            console.debug(TAG, '✅ BESTANDEN: Alle Blöcke von Bericht 1 erhalten.');
        } else {
            console.error(TAG, '❌ FEHLER 2.120:',
                verloren.map(function(id) { return id.slice(0, 8); }).join(', '), 'verloren.');
            console.debug(TAG, '  Erhalten:',
                erhalten.map(function(id) { return id.slice(0, 8); }).join(', ') || '(keine)');
        }

        console.debug(TAG, '--- Fetch-Log (' + _fetchLog.length + ' Einträge) ---');
        _fetchLog.forEach(function(e) {
            console.debug(TAG, ' ', e.ts, e.method,
                e.url.split('?')[0], 'rid=' + (e.report_id ?? '—'), 'action=' + (e.action ?? '—'));
        });
        console.debug(TAG, '='.repeat(60));
    }

    // -----------------------------------------------------------------------
    // Start-Button
    // -----------------------------------------------------------------------
    var existing = document.getElementById('diag-2120-btn');
    if (existing) existing.remove();

    var btn = document.createElement('button');
    btn.id = 'diag-2120-btn';
    btn.textContent = '[DIAG] 2.120 Test starten';
    btn.style.cssText = [
        'position:fixed', 'bottom:16px', 'right:16px', 'z-index:99999',
        'background:#c0392b', 'color:#fff', 'border:none', 'border-radius:6px',
        'padding:8px 14px', 'font:bold 13px/1 monospace', 'cursor:pointer',
        'box-shadow:0 2px 8px rgba(0,0,0,.4)',
    ].join(';');
    btn.addEventListener('click', async function() {
        btn.disabled = true;
        btn.textContent = '[DIAG] läuft…';
        try { await _runTest(); }
        finally {
            btn.disabled = false;
            btn.textContent = '[DIAG] Nochmal';
        }
    });
    document.body.appendChild(btn);

    console.debug(TAG, '='.repeat(60));
    console.debug(TAG, 'Bereit. Roter Button unten rechts klicken.');
    console.debug(TAG, 'Voraussetzung: Bericht 1 hat min. einen gespeicherten Block.');
    console.debug(TAG, '='.repeat(60));

})();
