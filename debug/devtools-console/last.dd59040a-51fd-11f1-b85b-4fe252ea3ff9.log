/**
 * IIFE-Diagnosescript: Bug 2.104
 * Berichtseditor — Doppelklick erzeugt keinen Block (nach vorherigem Löschen)
 *
 * ANLEITUNG:
 *   1. Berichtseditor öffnen, neuen Bericht anlegen.
 *   2. Ein Modul per Doppelklick einfügen.
 *   3. Den Block mit der Editor-Toolbar löschen (⋮ → Löschen oder Backspace).
 *   4. SOFORT (< 2 Sekunden) dieses Script in DevTools-Console einfügen + Enter.
 *   5. Bestätigung "[DIAG 2.104]: Monitoring aktiv" abwarten.
 *   6. Sofort wieder einen Doppelklick auf ein Modul ausführen.
 *   7. 3 Sekunden warten.
 *   8. Alle [DIAG 2.104]-Zeilen kopieren und bereitstellen.
 *
 * Alternativ: Script VOR dem Löschen einfügen — dann den Ablauf wie oben.
 *
 * WAS BEOBACHTET WIRD:
 *   A) _isReloading-Status beim Doppelklick
 *   B) Ob _insertModule durch den Reload-Guard gebremst wird
 *   C) Block-IDs im Editor zu verschiedenen Zeitpunkten
 *   D) Fetch-Requests (save_block, delete)
 */
(function () {
    'use strict';

    const TAG = '[DIAG 2.104]';
    const ts  = () => new Date().toISOString().slice(11, 23);

    // -----------------------------------------------------------------------
    // A) isReloading() überwachen
    // -----------------------------------------------------------------------
    const origIsReloading = window.ReportEditor?.isReloading;
    if (!origIsReloading) {
        console.warn(TAG, 'WARNUNG: window.ReportEditor.isReloading nicht gefunden!');
        console.warn(TAG, 'Build 204+ erforderlich. Aktuell:', window._buildnr);
    } else {
        // Periodischer Status-Check
        let _lastReloadingState = null;
        setInterval(() => {
            const state = window.ReportEditor.isReloading();
            if (state !== _lastReloadingState) {
                _lastReloadingState = state;
                console.debug(TAG, ts(), '_isReloading geändert →', state);
            }
        }, 50);
        console.debug(TAG, '_isReloading-Polling aktiv (50ms).');
    }

    // -----------------------------------------------------------------------
    // B) _reloadEditorContent überwachen via window-Exports
    // -----------------------------------------------------------------------
    // Kein direkter Zugriff möglich — wir beobachten indirekt via fetch-Intercept

    // -----------------------------------------------------------------------
    // C) fetch-Intercept
    // -----------------------------------------------------------------------
    const origFetch = window.fetch;
    window.fetch = async function (url, opts) {
        const urlStr = typeof url === 'string' ? url : url?.url ?? String(url);
        if (urlStr.includes('/_forensic/report') || urlStr.includes('/_forensic/editor')) {
            const method = opts?.method || 'GET';
            let body = null;
            try { body = opts?.body ? JSON.parse(opts.body) : null; } catch (_) {}
            if (method === 'POST' && body) {
                const reloading = window.ReportEditor?.isReloading?.() ?? '?';
                console.debug(TAG, ts(),
                    `fetch POST ${urlStr.split('/').pop()}`,
                    '| action:', body.action ?? '—',
                    '| block_id:', (body.block_id ?? '—').slice(0, 8) + '…',
                    '| _isReloading:', reloading
                );
            }
        }
        return origFetch.apply(this, arguments);
    };

    // -----------------------------------------------------------------------
    // D) Doppelklick auf .mp-item → Zeitreihe
    // -----------------------------------------------------------------------
    document.addEventListener('dblclick', (evt) => {
        if (!evt.target.closest('.mp-item')) return;
        const reloading = window.ReportEditor?.isReloading?.() ?? '?';
        console.debug(TAG, ts(), 'DOPPELKLICK — _isReloading:', reloading);

        const snapshots = [0, 50, 150, 300, 500, 800, 1200, 2000, 3000];
        snapshots.forEach(delay => {
            setTimeout(() => {
                const ed = window._editor;
                const edIds = [];
                try {
                    if (ed?.blocks) {
                        const n = ed.blocks.getBlocksCount();
                        for (let i = 0; i < n; i++) {
                            edIds.push(ed.blocks.getBlockByIndex(i)?.id ?? '?');
                        }
                    }
                } catch (e) { edIds.push('ERR:' + e.message); }

                const reloading2 = window.ReportEditor?.isReloading?.() ?? '?';
                console.debug(TAG, ts(),
                    `T+${delay}ms`,
                    '| _isReloading:', reloading2,
                    '| Editor-Blöcke:', edIds.length,
                    '| IDs:', edIds.map(id => id.slice(0, 8)).join(', ')
                );
            }, delay);
        });
    }, { capture: true, passive: true });

    // -----------------------------------------------------------------------
    // E) Lösch-Events überwachen
    // -----------------------------------------------------------------------
    // Bereits durch onChange-Logging in Build 205 abgedeckt.
    // Wir loggen zusätzlich block-removed im onChange via Proxy auf _editor.

    function _tryWrapEditor() {
        const ed = window._editor;
        if (!ed || ed._diag104Wrapped) return;
        ed._diag104Wrapped = true;

        // onChange ist eine Closure — wir können es nicht wrappen.
        // Stattdessen: MutationObserver auf #editorjs-holder für CE-Block-Entfernung
        const holder = document.getElementById('editorjs-holder');
        if (!holder) return;

        const mo = new MutationObserver((mutations) => {
            for (const m of mutations) {
                for (const node of m.removedNodes) {
                    if (node.nodeType === 1 && node.classList?.contains('ce-block')) {
                        const blockId = node.dataset?.id ?? '?';
                        const reloading = window.ReportEditor?.isReloading?.() ?? '?';
                        console.debug(TAG, ts(),
                            'MutationObserver: ce-block entfernt',
                            '| block_id:', blockId.slice(0, 8),
                            '| _isReloading:', reloading
                        );
                    }
                }
            }
        });
        mo.observe(holder, { childList: true, subtree: false });
        console.debug(TAG, 'MutationObserver auf #editorjs-holder installiert.');
    }

    // Polling bis Editor bereit
    const _poll = setInterval(() => {
        if (window._editor) {
            _tryWrapEditor();
            clearInterval(_poll);
        }
    }, 200);

    // Nach _reloadEditorContent neu wrappen (Editor wird zerstört und neu erstellt)
    setInterval(() => {
        if (window._editor && !window._editor._diag104Wrapped) {
            _tryWrapEditor();
        }
    }, 500);

    console.debug(TAG, '='.repeat(50));
    console.debug(TAG, 'DIAG 2.104: Monitoring aktiv. Build:', window._buildnr ?? '?');
    console.debug(TAG, 'Ablauf: Block einfügen → löschen → sofort Doppelklick');
    console.debug(TAG, '='.repeat(50));

})();
